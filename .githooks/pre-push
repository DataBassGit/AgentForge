#!/usr/bin/env bash
set -euo pipefail

ZERO_SHA="0000000000000000000000000000000000000000"

log() {
    printf '\n[pre-push] %s\n' "$*"
}

fail() {
    printf '\n[pre-push] %s\n' "$*" >&2
    exit 1
}

find_python() {
    if [[ -n "${AGENTFORGE_PYTHON:-}" ]]; then
        printf '%s\n' "$AGENTFORGE_PYTHON"
        return 0
    fi

    if [[ -x ".venv/bin/python" ]]; then
        printf '%s\n' "$(pwd)/.venv/bin/python"
        return 0
    fi

    if [[ -x "venv/bin/python" ]]; then
        printf '%s\n' "$(pwd)/venv/bin/python"
        return 0
    fi

    if command -v python3 >/dev/null 2>&1; then
        command -v python3
        return 0
    fi

    if command -v python >/dev/null 2>&1; then
        command -v python
        return 0
    fi

    return 1
}

default_compare_ref() {
    local ref

    ref="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    if [[ -n "$ref" ]]; then
        printf '%s\n' "$ref"
        return 0
    fi

    for ref in origin/main origin/dev origin/master; do
        if git rev-parse --verify --quiet "$ref" >/dev/null; then
            printf '%s\n' "$ref"
            return 0
        fi
    done

    return 1
}

diff_base_for_ref() {
    local local_sha="$1"
    local remote_sha="$2"
    local default_ref

    if [[ "$remote_sha" != "$ZERO_SHA" ]]; then
        printf '%s\n' "$remote_sha"
        return 0
    fi

    default_ref="$(default_compare_ref || true)"
    if [[ -n "$default_ref" ]]; then
        git merge-base "$local_sha" "$default_ref"
        return 0
    fi

    git rev-list --max-parents=0 "$local_sha" | tail -n 1
}

collect_pushed_python_files() {
    local local_ref
    local local_sha
    local remote_ref
    local remote_sha
    local base
    local file

    while read -r local_ref local_sha remote_ref remote_sha; do
        [[ -z "${local_ref:-}" ]] && continue
        [[ "$local_sha" == "$ZERO_SHA" ]] && continue

        base="$(diff_base_for_ref "$local_sha" "$remote_sha")"
        while IFS= read -r file; do
            [[ -n "$file" ]] && pushed_python_files["$file"]=1
        done < <(git diff --name-only --diff-filter=ACMR "$base" "$local_sha" -- '*.py')
    done
}

run_check() {
    local label="$1"
    shift

    log "$label"
    "$@"
}

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

declare -A pushed_python_files=()
collect_pushed_python_files
python_files=()
if ((${#pushed_python_files[@]} > 0)); then
    mapfile -t python_files < <(printf '%s\n' "${!pushed_python_files[@]}" | sort)
fi

python_bin="$(find_python)" || fail "Could not find a Python interpreter. Activate .venv or set AGENTFORGE_PYTHON."
log "Using Python: $python_bin"

if ((${#python_files[@]} > 0)); then
    run_check "Ruff lint on pushed Python files" "$python_bin" -m ruff check --force-exclude "${python_files[@]}"
    run_check "Ruff format check on pushed Python files" "$python_bin" -m ruff format --check --force-exclude "${python_files[@]}"
    run_check "basedpyright on pushed Python files" "$python_bin" -m basedpyright --project pyproject.toml "${python_files[@]}"
else
    log "No pushed Python files; skipping scoped Ruff and basedpyright checks."
fi

run_check "pytest default suite" "$python_bin" -m pytest

log "All pre-push checks passed."
